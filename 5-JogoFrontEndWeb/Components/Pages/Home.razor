@page "/home"
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Jogo advinhe o numero</PageTitle>

<h1>Bem vindo de volta @nomeJogador</h1>


<button class="btn btn-primary" @onclick="iniciarPartida">JOGAR</button>

@code {

    private string idJogador = "";
    private string nomeJogador = "";

    protected override async Task OnInitializedAsync()
    {
        idJogador = await LocalStorage.GetItemAsync<string>("idJogador");
        nomeJogador = await LocalStorage.GetItemAsync<string>("nomeJogador");
    }

    private void iniciarPartida()
    {
        Navigation.NavigateTo("/game", replace: true);
    }


}
