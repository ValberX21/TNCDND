@page "/home"
@inject HttpClient Http
@using _5_JogoFrontEndWeb.Models
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Jogo advinhe o numero</PageTitle>

<h1>Bem vindo @nomeJogador</h1>

<div class="d-flex gap-4 mt-4">

    <div class="card" style="width: 22rem;">
        <div class="card-body">
            <h5 class="card-title">Seu Desempenho</h5>
            <p class="card-text">
                <strong>Vitórias:</strong> @vitorias <br />
                <strong>Derrotas:</strong> @derrotas <br />
                <strong>Taxa de Vitória:</strong> @porcentagemVitória.ToString("0.00")% <br />
                <strong>Voce esta no rank:</strong> @rank <br />
            </p>
        </div>
    </div>

</div>

<button class="btn btn-primary mt-4" @onclick="iniciarPartida">JOGAR</button>

@code {

    private List<Jogos> jogosCount = new List<Jogos>();
    private double porcentagemVit = 0;
    private string rank = "";
    private string idJogador = "";
    private string nomeJogador = "";
    private int vitorias = 0;
    private int derrotas = 0;
    private double porcentagemVitória = 0;
    private bool initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !initialized)
        {
            initialized = true;
            idJogador = await LocalStorage.GetItemAsync<string>("idJogador");
            nomeJogador = await LocalStorage.GetItemAsync<string>("nomeJogador");

            try
            {
                var jogoJogador = await Http.GetFromJsonAsync<List<Jogos>>($"https://localhost:44387/jogos/listjogos/{idJogador}");

                if (jogoJogador != null)
                {
                    jogosCount = jogoJogador;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao buscar tentativas: {ex.Message}");
            }

            vitorias = jogosCount.Count(j => j.RESULTADO_JOGO == "VITORIA");
            derrotas = jogosCount.Count(j => j.RESULTADO_JOGO == "DERROTA");

            int totalPartidas = vitorias + derrotas;

            if (totalPartidas > 0)
            {
                porcentagemVitória = (vitorias * 100.0) / totalPartidas;
            }
            else
            {
                porcentagemVitória = 0;
            }

            porcentagemVit = porcentagemVitória;
            rank = CalcularRank(vitorias, derrotas);

            StateHasChanged();

        }       
    }

    private void iniciarPartida()
    {
        Navigation.NavigateTo("/game", replace: true);
    }

    private string CalcularRank(int vitorias, int derrotas)
    {
        if(vitorias == 0 && derrotas == 0)
        {
            return "Sem rank";
        }
        else
        {
            if (derrotas == 0 && vitorias > 0)
                return "S";

            double pct = (double)vitorias / (vitorias + derrotas) * 100;

            return pct switch
            {
                >= 90 => "A",
                >= 75 => "B",
                >= 50 => "C",
                >= 25 => "D",
                _ => "E"
            };
        }       
    }
}
