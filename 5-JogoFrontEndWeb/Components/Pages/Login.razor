@page "/"

@inject HttpClient Http
@inject NavigationManager Navigation
@inject _5_JogoFrontEndWeb.Services.LoginState LoginState
@using _5_JogoFrontEndWeb.Models
@inject Jogador JogadorDados
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="d-flex justify-content-center align-items-center min-vh-100">
    <div class="d-flex gap-5">

        <div class="card p-4" style="width: 300px;">
            <h3>Login jogador</h3>

            <EditForm Model="@loginData" OnValidSubmit="LoginJogador">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div>
                    <label>Nome do jogador:</label>
                    <InputText @bind-Value="loginData.NomeJogador" class="form-control" />

                    <label class="mt-2">Senha:</label>
                    <InputText @bind-Value="loginData.Senha" class="form-control" type="password" />

                    <button type="submit" class="btn btn-primary mt-3">Login</button>

                    @if (!string.IsNullOrEmpty(Message))
                    {
                        <p class="text-danger mt-2">@Message</p>
                    }
                </div>
            </EditForm>
        </div>

        <div class="card p-4" style="width: 300px;">
            <h3>Criar novo jogador</h3>

            <EditForm Model="@createData" OnValidSubmit="CreateJogador">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div>
                    <label>Nome do novo jogador:</label>
                    <InputText @bind-Value="createData.NovoJogadorNome" class="form-control" />

                    <label class="mt-2">Senha:</label>
                    <InputText @bind-Value="createData.NovoJogadorSenha" class="form-control" type="password" />

                    <button type="submit" class="btn btn-success mt-3">Create</button>

                    @if (!string.IsNullOrEmpty(CreateMessage))
                    {
                        <p class="text-success mt-2">@CreateMessage</p>
                    }
                </div>
            </EditForm>
        </div>

    </div>
</div>

@code {
    private LoginModel loginData = new();
    private CreateModel createData = new();
    private string Message = "";
    private string CreateMessage = "";

    private async Task LoginJogador()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("https://localhost:44387/jogadores/login", new
            {
                NomeJogador = loginData.NomeJogador,
                Senha = loginData.Senha
            });

            if (response.IsSuccessStatusCode)
            {
                var dadosJogado = await response.Content.ReadFromJsonAsync<LoginResponse>();

                if(dadosJogado != null)
                {
                    await LocalStorage.SetItemAsync("idJogador", dadosJogado.Jogador.IdJogador);
                    await LocalStorage.SetItemAsync("nomeJogador", dadosJogado.Jogador.NomeJogador);

                    LoginState.Login();
                    Navigation.NavigateTo("/home", replace: true);

                }else
                {
                    Message = "Erro ao carregador os dados do jogador";
                }
               
            }
            else
            {
                Message = "Jogador ou senha incorretos";
            }
        }
        catch (Exception ex)
        {
            Message = $"Erro ao tentar logar: {ex.Message}";
        }
    }

    private async Task CreateJogador()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("https://localhost:44387/jogadores/create", new
            {
                NomeJogador = createData.NovoJogadorNome,
                Senha = createData.NovoJogadorSenha
            });

            if (response.IsSuccessStatusCode)
            {
                var dadosJogado = await response.Content.ReadFromJsonAsync<LoginResponse>();

                if (dadosJogado != null)
                {
                    await LocalStorage.SetItemAsync("idJogador", dadosJogado.Jogador.IdJogador);
                    await LocalStorage.SetItemAsync("nomeJogador", dadosJogado.Jogador.NomeJogador);

                    LoginState.Login();
                    Navigation.NavigateTo("/home", replace: true);

                }
                else
                {
                    Message = "Erro ao carregador os dados do jogador";
                }

            }
            else
            {
                CreateMessage = "Erro ao criar usuário. Status: " + response.StatusCode;
            }
        }
        catch (Exception ex)
        {
            CreateMessage = $"Erro de comunicação: {ex.Message}";
        }
    }

}
